# Copy to .env (never commit .env) and fill in.

# Port the API listens on.
PORT=4000

# MongoDB Atlas connection string (Atlas → Connect → Drivers). Needed from stage 2 on.
MONGODB_URI=

# Website address(es) allowed to call the API, comma-separated.
WEB_ORIGIN=http://localhost:5173

# Folder for uploaded photos, relative to server/ or absolute. Use a persistent disk in production.
UPLOADS_DIR=uploads

# true enables demo logins and the "Reset demo" endpoint. Leave false in a real deployment.
DEMO_MODE=false
