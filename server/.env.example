# Copy to .env (never commit .env) and fill in.

# Port the API listens on.
PORT=4000

# MongoDB Atlas connection string (Atlas → Connect → Drivers).
MONGODB_URI=

# Database name inside the cluster.
MONGODB_DB=roopawas-seva

# Website address(es) allowed to call the API, comma-separated.
WEB_ORIGIN=http://localhost:5173

# Secret for signing the short-lived photo links (any long random text). Optional; without it a new one
# is made at each start, which only means photo links from before a restart stop working.
PHOTO_SECRET=

# Number of reverse proxies in front of the server (e.g. 1 behind Nginx or a hosting load balancer),
# so login rate limits see visitors' real IP addresses. 0 when reached directly.
TRUST_PROXY=0

# Folder for uploaded photos, relative to server/ or absolute. Use a persistent disk in production.
UPLOADS_DIR=uploads

# true enables demo logins, the "Reset demo" endpoint and `npm run seed`. Leave false in a real deployment.
DEMO_MODE=false

# The first super admin, created by `npm run setup` if the database has none (not needed for the demo seed).
# Log in with SUPERADMIN_LOGIN + SUPERADMIN_PIN, then create the other admins from the website.
SUPERADMIN_LOGIN=
SUPERADMIN_PIN=
SUPERADMIN_NAME=
SUPERADMIN_MOBILE=
