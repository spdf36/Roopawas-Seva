# Public settings baked into the app when it is started or built (EXPO_PUBLIC_* values end up inside the APK,
# so never put secrets here). Override on your own computer with app/.env.local, e.g. a local server:
#   EXPO_PUBLIC_API_URL=http://192.168.1.20:4000
# or leave it empty there to run on the built-in demo data.
EXPO_PUBLIC_API_URL=https://api.roopawas.in
